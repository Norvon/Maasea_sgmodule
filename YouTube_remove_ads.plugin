#!name=LGYouTube去广告
#!desc=移除YouTube视频、瀑布流、搜索和Shorts中的广告，支持隐藏上传和Shorts按钮、恢复底栏订阅按钮，增加画中画功能。
#!author=LG
#!tag=去广告
#!date=2026-11-10 13:50:51


[Argument]
blockUpload=switch,false,true,tag=隐藏上传按钮,desc=用于隐藏YouTube底栏的上传按钮
blockShorts=switch,false,true,tag=隐藏Shorts按钮,desc=用于隐藏YouTube底栏的Shorts按钮
restoreSubscriptions=switch,false,true,tag=恢复底栏订阅,desc=尝试恢复YouTube底栏的订阅按钮，首页顶部Subs保留
debug=switch,false,true,tag=启用调试模式,desc=此插件的调试模式


[Rule]
AND,((DOMAIN-SUFFIX,googlevideo.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN-SUFFIX,youtubei.googleapis.com),(PROTOCOL,QUIC)),REJECT


[Rewrite]
#^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback.+&oad mock-response-body data-type=text status-code=502
^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback.+&oad reject-200


[Script]
http-response ^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/(browse|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch) script-path=https://raw.githubusercontent.com/Norvon/Maasea_sgmodule/refs/heads/feature/lg/Script/Youtube/dist/youtube.response.preview.js?v=20261110135051,requires-body=true,binary-body-mode=true,argument=[{blockUpload},{blockShorts},{restoreSubscriptions},{debug}],tag=LGYouTube去广告


[MitM]
hostname=*.googlevideo.com,youtubei.googleapis.com
